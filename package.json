{
  "name": "@api.sh/cli",
  "version": "0.1.0",
  "description": "Command line for API.SH, which turns public web pages from around 1,000 websites into clean JSON: search engines, social media, e-commerce, real estate, jobs, travel, news and sports (Google, Amazon, TikTok, Zillow, LinkedIn and more). JSON, CSV or NDJSON output.",
  "keywords": ["api.sh", "apish", "cli", "web data", "json", "csv", "tiktok", "zillow", "google", "amazon", "reddit"],
  "homepage": "https://github.com/API-SH/apish-cli#readme",
  "repository": { "type": "git", "url": "git+https://github.com/API-SH/apish-cli.git" },
  "bugs": "https://github.com/API-SH/apish-cli/issues",
  "license": "MIT",
  "author": "API.SH <support@api.sh>",
  "type": "module",
  "bin": { "apish": "bin/apish.js" },
  "exports": { ".": "./src/cli.js" },
  "files": ["bin", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "test:live": "node --test test/live.test.js"
  },
  "dependencies": {
    "@api.sh/sdk": "^0.3.0"
  },
  "publishConfig": { "access": "public", "provenance": true }
